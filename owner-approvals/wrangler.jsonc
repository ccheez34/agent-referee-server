// The owner-approvals Worker: apart from Agent Referee, with its own key and the owner's own token.
// Secrets (set by the owner, never in this file): OWNER_TOKEN, READ_TOKEN, APPROVALS_SIGNING_KEY.
// Deploying it is the owner's (installing a server is on his owner-only list).
{
  "name": "owner-approvals",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "APPROVALS", "class_name": "ApprovalStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApprovalStore"] }],
  "vars": {
    // The public half of the approvals key (scripts/gen-keys.mjs prints it). Gates pin this value.
    "APPROVALS_PUBLIC_KEY": ""
  }
}
